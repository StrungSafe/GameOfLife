{
  "name": "@gol/core",
  "version": "0.1.0",
  "private": true,
  "description": "Conway's Game of Life on Bitcoin Cash: contracts, board logic and the game client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contracts"
  ],
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "build": "yarn compile && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "cashscript": "0.13.3"
  },
  "devDependencies": {
    "@types/node": "24",
    "cashc": "0.13.3",
    "typescript": "~5.9",
    "vite": "^8",
    "vitest": "^5.0.2"
  }
}
