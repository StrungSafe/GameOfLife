pragma cashscript ^0.13.0;

/*
 * GameOfLife - Conway's Game of Life as a self-funding CashTokens covenant.
 *
 * The game state lives in the commitment of a single mutable NFT of `stateCategory`,
 * which never leaves this contract. Anyone may advance the game or start a new one;
 * the contract pays the transaction fee out of its own balance (bounded by `maxFee`).
 *
 * Board encoding: `width * height` cells, row-major, packed as a big-endian bit string
 * (cell (x, y) is bit index y * width + x, the MSB of byte 0 is bit index 0).
 * `width * height` must be a multiple of 8.
 *
 * NFT commitment layout (121 bytes):
 *   [0, 4)     gameId      (VM number padded to 4 bytes)
 *   [4, 8)     generation  (VM number padded to 4 bytes)
 *   [8, 9)     status      0x00 = running, 0x01 = ended (a new game may be started)
 *   [9, 121)   history     digests (sha256 truncated to 16 bytes) of the last 7 boards,
 *                          newest first. history[0] is the digest of the current board.
 *
 * A game runs until the board dies out or repeats one of its previous 7 boards (still lifes
 * and oscillators with period <= 7); there is no generation limit. An ended game can always
 * be replaced by a new one, so the contract recovers from every ending on its own.
 *
 * The board is never stored in the commitment; it is revealed as the unlocking argument of
 * every move, which also makes the whole history replayable from the chain.
 */
contract GameOfLife(bytes32 stateCategory, int width, int height, int maxFee) {
    // generations == 0: start a new game with `board` (only once the previous game ended).
    // generations >= 1: advance the running game, whose current board is `board`, by that many
    //                   generations in one transaction, which spreads the fixed cost of a move
    //                   (board, contract code, state output) over several generations.
    function play(bytes board, int generations) {
        require(this.activeInputIndex == 0);
        bytes stateToken = stateCategory + 0x01;
        require(tx.inputs[0].tokenCategory == stateToken);

        bytes commitment = tx.inputs[0].nftCommitment;
        bytes status = commitment.slice(8, 9);
        bytes history = commitment.slice(9, 121);
        int size = width * height / 8;
        require(board.length == size);
        bytes empty = toPaddedBytes(0, size);
        bytes newCommitment = 0x;

        if (generations == 0) {
            require(status == 0x01, "game is still running");
            require(board != empty, "board is empty");
            newCommitment = toPaddedBytes(int(commitment.slice(0, 4)) + 1, 4) + toPaddedBytes(0, 5)
                + sha256(board).slice(0, 16) + toPaddedBytes(0, 96);
        } else {
            require(generations > 0);
            require(status == 0x00, "game has ended");
            require(sha256(board).slice(0, 16) == history.slice(0, 16), "board does not match state");

            // Column masks: a bit at x = 0 in every row, then x = width - 1 in every row.
            bytes firstCol = 0x80 + toPaddedBytes(0, size - 1);
            int rows = 1;
            do {
                firstCol = firstCol | (firstCol >> (rows * width));
                rows = rows * 2;
            } while (rows < height);
            bytes notFirstCol = ~firstCol;
            bytes notLastCol = ~(firstCol >> (width - 1));

            // Advance generation by generation. The loop state is declared last so it stays near
            // the top of the stack; `recent` collects the digest of every new board (newest first)
            // and doubles as the loop counter.
            bytes cur = board;
            bytes recent = history;
            do {
                // Neighbour in the east (x + 1) and the west (x - 1) of every cell.
                bytes east = (cur << 1) & notLastCol;
                bytes west = (cur >> 1) & notFirstCol;

                // Two-bit sum of (west, self, east), used for the rows above (y - 1) and below (y + 1).
                bytes ew = east ^ west;
                bytes mid = east & west;
                bytes up0 = (ew ^ cur) >> width;
                bytes down0 = (ew ^ cur) << width;
                bytes up1 = (mid | (cur & ew)) >> width;
                bytes down1 = (mid | (cur & ew)) << width;

                // Add up + down + (east + west): bit 0 of the sum and the carry into bit 1.
                bytes ud0 = up0 ^ down0;
                bytes carry0 = (up0 & down0) | (ew & ud0);

                // Bit 1 inputs are up1, down1, mid and carry0. A cell has 2 or 3 neighbours exactly
                // when one of those four is set; it lives with 3, or with 2 if it was alive.
                bytes ud1 = up1 ^ down1;
                bytes mc1 = mid ^ carry0;
                cur = (ud1 ^ mc1) & ~((up1 & down1) | (mid & carry0) | (ud1 & mc1)) & ((ud0 ^ ew) | cur);
                recent = sha256(cur).slice(0, 16) + recent;
            } while (recent.length < 112 + generations * 16);

            // The game ends when the board has died out or repeats one of the 7 boards before it.
            // Both are permanent, so checking the final board is enough.
            bytes digest = recent.slice(0, 16);
            bool ended = cur == empty;
            for (int h = 16; h < 128; h = h + 16) {
                if (recent.slice(h, h + 16) == digest) {
                    ended = true;
                }
            }
            status = 0x00;
            if (ended) {
                status = 0x01;
            }
            newCommitment = commitment.slice(0, 4) + toPaddedBytes(int(commitment.slice(4, 8)) + generations, 4)
                + status + recent.slice(0, 112);
        }

        // The NFT stays here with the new state and every input's value is carried over,
        // minus a bounded fee that pays for this transaction.
        int total = 0;
        for (int i = 0; i < tx.inputs.length; i = i + 1) {
            total = total + tx.inputs[i].value;
        }
        require(tx.outputs.length == 1);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == stateToken);
        require(tx.outputs[0].nftCommitment == newCommitment);
        require(tx.outputs[0].value >= total - maxFee, "fee too high");
    }
}
